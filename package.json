{
  "name": "afo-public-website",
  "version": "1.0.0",
  "private": true,
  "description": "Public landing page for AFO (AI Front Office for service businesses) at proportion.systems.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node tools/serve.mjs",
    "check": "node build.mjs && node tools/check.mjs",
    "screenshots": "node build.mjs && node tools/screenshots.mjs",
    "a11y": "node build.mjs && node tools/a11y.mjs",
    "copy": "node build.mjs && node tools/extract-copy.mjs",
    "og": "node tools/og.mjs",
    "verify": "npm run check && npm run a11y && npm run screenshots && npm run copy"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "^1.62.0"
  }
}
